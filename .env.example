# ---------------------------------------------------------------------
# Leave these empty to run in DEMO MODE — the app boots with sample data
# and no database. Fill them in when your Supabase project exists.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# e-Racuni. Server-only, used by scheduled jobs and invoice creation.
ERACUNI_API_URL=
ERACUNI_API_KEY=

# Delivery documents e-mail. MAIL_FROM plus ONE of the two transports below.
# Until both the company details (src/lib/documents/company.ts) and a transport
# are set, documents are still generated and stored but stay "queued".
MAIL_FROM="Ime podjetja <naslov@vasa-domena.si>"
# Optional: office copy of every mail, and where customer replies go.
MAIL_BCC=
MAIL_REPLY_TO=

# Transport A: SMTP — any mailbox. Gmail: smtp.gmail.com, port 465, a Google
# "app password" (needs 2-step verification); MAIL_FROM must be that address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Transport B: Resend — needs a verified sending domain.
RESEND_API_KEY=

# Web push for the driver's 5pm plan. Generate the pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer secret for /api/cron/* (Vercel sends it automatically).
CRON_SECRET=
