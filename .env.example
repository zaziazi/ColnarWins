# ---------------------------------------------------------------------
# Leave these empty to run in DEMO MODE — the app boots with sample data
# and no database. Fill them in when your Supabase project exists.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# e-Racuni. Server-only, used by scheduled jobs and invoice creation.
ERACUNI_API_URL=
ERACUNI_API_KEY=

# Delivery documents e-mail (Resend). Without both, documents are still
# generated and stored but stay "queued" instead of being sent.
RESEND_API_KEY=
MAIL_FROM=

# Web push for the driver's 5pm plan. Generate the pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer secret for /api/cron/* (Vercel sends it automatically).
CRON_SECRET=
