# ---------------------------------------------------------------------
# Leave these empty to run in DEMO MODE — the app boots with sample data
# and no database. Fill them in when your Supabase project exists.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# e-Racuni. Server-only, used by scheduled jobs and invoice creation.
ERACUNI_API_URL=
ERACUNI_API_KEY=

# Delivery documents e-mail. MAIL_FROM plus ONE of the two transports below.
# Until both the company details (src/lib/documents/company.ts) and a transport
# are set, documents are still generated and stored but stay "queued".
MAIL_FROM="Ime podjetja <naslov@vasa-domena.si>"
# Optional: office copy of every mail, and where customer replies go.
# SAFE TEST MODE: while set, every mail goes ONLY to this address (whoever the
# customer is) and placeholder company details don't block sending. Empty = live.
MAIL_ONLY_TO=
MAIL_BCC=
MAIL_REPLY_TO=

# Transport A: SMTP — any mailbox. Gmail: smtp.gmail.com, port 465, a Google
# "app password" (needs 2-step verification); MAIL_FROM must be that address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Transport B: Resend — needs a verified sending domain.
RESEND_API_KEY=

# Web push for the driver's 5pm plan. Generate the pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer secret for /api/cron/* (Vercel sends it automatically).
CRON_SECRET=

# Google Places API (New) — rating/reviews on the venue sheet. Server-side only; leave empty to hide the feature.
# Create the key in Google Cloud (see README), restrict it to "Places API (New)".
GOOGLE_PLACES_API_KEY=
# Hard monthly stop on paid lookups (Google gives 1,000 free calls/month for this tier).
GOOGLE_PLACES_MONTHLY_CAP=900

# Društva outreach — Instantly webhook (header x-colnix-secret) and, later, API/AI keys. Server-side only.
INSTANTLY_WEBHOOK_SECRET=
INSTANTLY_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Degustacije — website reservation mailbox. Secret for /api/degustacije/inbound (header x-colnix-secret).
DEGUSTACIJE_INBOUND_SECRET=
# Sending replies from that mailbox (SMTP; Gmail: smtp.gmail.com, 465, app password)
DEGUSTACIJE_SMTP_HOST=
DEGUSTACIJE_SMTP_PORT=465
DEGUSTACIJE_SMTP_USER=
DEGUSTACIJE_SMTP_PASS=
DEGUSTACIJE_MAIL_FROM=
# Day-before messages to presenters / kitchen via Twilio (SMS and WhatsApp). Leave empty to send by hand from the calendar.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
